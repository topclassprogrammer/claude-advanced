{
  "enabledMcpjsonServers": ["playwright"],
  "permissions": {
    "allow": [
    "Edit(*)",
    "Write(*)",
    "Bash(npm run test)",
    "Bash(npm run test:e2e)",
    "Bash(git *)",
    "Bash(gh *)",
    "Bash(npx prisma *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [{
          "type": "command",
          "command": "node .claude/hooks/stop.js"
        }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-format.sh\"",
            "statusMessage": "Форматирование изменённого файла (prettier)..."
          }
        ]
      }
    ]
  }
}
