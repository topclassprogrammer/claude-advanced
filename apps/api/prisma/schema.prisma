// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String
  passwordChangedAt DateTime?
  name              String?
  avatarPath        String?
  avatarMimeType    String?
  avatarUploadedAt  DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  meetings          Meeting[]
  refreshTokens     RefreshToken[]
}

model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  /**
   * Заполняется, только когда токен погашен нормальной ротацией
   * (POST /auth/refresh) — отличает такой отзыв от явного (logout, смена
   * пароля, детект кражи), у которого это поле остаётся null. Используется,
   * чтобы grace period для повторного предъявления токена (гонка вкладок)
   * применялся только к ротации, а не маскировал реальный logout/revoke.
   */
  replacedByTokenId String?
  /**
   * Общий id для всей цепочки токенов, порождённой одним issue
   * (login/register) — каждая ротация и толерантный grace-period повтор
   * наследуют его от родителя. Позволяет отозвать разом всю цепочку
   * (logout/смена пароля/детект кражи) через familyRevokedAt, а не только
   * строки с revokedAt: null — иначе токен, отозванный ротацией меньше
   * REUSE_GRACE_PERIOD_MS назад, мог бы породить новую независимую от
   * отзыва цепочку в обход logout/смены пароля/детекта кражи.
   */
  familyId          String
  /**
   * Ставится разом на все строки цепочки (по familyId, независимо от их
   * текущего revokedAt) при явном отзыве — logout, смена пароля, детект
   * кражи. Пока это поле null, недавно ротированный токен (в пределах
   * REUSE_GRACE_PERIOD_MS) ещё может толерантно выдать дочерний токен;
   * непустое значение немедленно и необратимо закрывает эту grace-ветку
   * для всей цепочки.
   */
  familyRevokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([familyId])
}

model Meeting {
  id           String        @id @default(uuid())
  title        String
  date         DateTime
  description  String?
  participants String[]
  organizerId  String
  organizer    User          @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  files        MeetingFile[]
  tasks        Task[]        @relation("MeetingTasks")

  @@index([organizerId])
}

model MeetingFile {
  id            String                    @id @default(uuid())
  meetingId     String
  meeting       Meeting                   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  filename      String
  size          Int
  mimeType      String
  storagePath   String
  uploadedAt    DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  transcription MeetingFileTranscription?
  summary       MeetingFileSummary?

  @@index([meetingId])
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model MeetingFileTranscription {
  id            String              @id @default(uuid())
  meetingFileId String              @unique
  meetingFile   MeetingFile         @relation(fields: [meetingFileId], references: [id], onDelete: Cascade)
  status        TranscriptionStatus @default(PENDING)
  text          String?
  errorMessage  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([meetingFileId])
}

enum SummaryStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model MeetingFileSummary {
  id            String              @id @default(uuid())
  meetingFileId String              @unique
  meetingFile   MeetingFile         @relation(fields: [meetingFileId], references: [id], onDelete: Cascade)
  status        SummaryStatus       @default(PENDING)
  summary       String?
  decisions     String[]
  actionItems   SummaryActionItem[]
  errorMessage  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([meetingFileId])
}

model SummaryActionItem {
  id                   String             @id @default(uuid())
  meetingFileSummaryId String
  meetingFileSummary   MeetingFileSummary @relation(fields: [meetingFileSummaryId], references: [id], onDelete: Cascade)
  text                 String
  assignee             String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([meetingFileSummaryId])
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model Task {
  id              String     @id @default(uuid())
  title           String
  sourceMeetingId String?
  sourceMeeting   Meeting?   @relation("MeetingTasks", fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  status          TaskStatus @default(OPEN)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([sourceMeetingId, title])
  @@index([sourceMeetingId])
}
